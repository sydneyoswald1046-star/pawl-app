rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User-scoped storage. Owner read/write only; downloads via tokenized
    // download URLs handed out by the SDK are still public-with-token, which
    // is fine for invoice logos and client gallery thumbnails.
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
